# Copy to .env and fill in one key. .env is gitignored and never committed.
#
#   cp .env.example .env
#
# The reasoning engine needs none of this. `python smoke_test.py` runs the four
# required cases offline, with no key and no network. Only page extraction and
# metric clustering call a model.

# ---------------------------------------------------------------------------
# Provider. Set one key. If both are present, OpenAI wins unless you override
# with FACTLAYER_PROVIDER=anthropic.
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Any OpenAI-compatible endpoint works, which is the point of keeping the call
# surface in one file. Leave the base URL blank for OpenAI itself.
#
#   OpenAI      (blank)                                gpt-4o-mini
#   Groq        https://api.groq.com/openai/v1         llama-3.3-70b-versatile
#   Google      https://generativelanguage.googleapis.com/v1beta/openai
#                                                      gemini-2.5-flash-lite
#   NVIDIA      https://integrate.api.nvidia.com/v1    minimaxai/minimax-m3
#
# Pick a model that answers directly. A reasoning model spends the same token
# budget thinking that it spends answering, so it needs a much larger
# FACTLAYER_MAX_TOKENS to return complete JSON for a dense page.
FACTLAYER_OPENAI_MODEL=gpt-4o-mini
FACTLAYER_OPENAI_BASE_URL=
FACTLAYER_ANTHROPIC_MODEL=claude-sonnet-4-6
FACTLAYER_PROVIDER=

# ---------------------------------------------------------------------------
# Throughput. Workers set how many pages are read at once; RPM sets how fast
# the provider is willing to be asked. They are different numbers, and on a
# free tier raising workers alone just converts throughput into 429s.
# ---------------------------------------------------------------------------
FACTLAYER_WORKERS=8

# Requests per minute, shared across all workers. Blank means no throttle,
# which is right for a paid key. Set it to the tier's published limit
# otherwise; free tiers are usually 30 to 60.
FACTLAYER_RPM=

# Seconds before a single call is abandoned and retried. Raise it if pages are
# large and the model is slow, lower it if the endpoint tends to hang.
FACTLAYER_TIMEOUT=120

# Retries per call, exponentially backed off, for 429s and other transient
# failures.
FACTLAYER_RETRIES=6

# ---------------------------------------------------------------------------
# Limits. Every one of these exists so that a single upload cannot run up an
# unbounded bill or an unbounded disk write.
# ---------------------------------------------------------------------------
FACTLAYER_MAX_TOKENS=4000
FACTLAYER_MAX_CALLS_PER_DOC=150
FACTLAYER_MAX_UPLOAD_MB=60
FACTLAYER_MAX_PAGES_HARD=400

# Evidence spans are detected for personal data always. Turn this on to mask it
# in exports. Off by default, because a system that quietly rewrites its own
# evidence has stopped showing you the source.
FACTLAYER_MASK_PII=
